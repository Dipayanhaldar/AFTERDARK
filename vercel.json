{
  "rewrites": [
    {
      "source": "/guest",
      "destination": "/index.html"
    },
    {
      "source": "/guest/",
      "destination": "/index.html"
    },
    {
      "source": "/guest/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/guest.html",
      "destination": "/index.html"
    },
    {
      "source": "/invite/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|icon-|manifest\\.webmanifest|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}