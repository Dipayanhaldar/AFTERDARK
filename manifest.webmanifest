{
  "id": "com.afterdark.social",
  "name": "AFTERDARK — Couples Private Link & In-Chat Commerce",
  "short_name": "AFTERDARK",
  "description": "An 18+ invite-only couples space featuring dual-site QR + 6-digit OTP E2EE linking, private chat, and inline in-chat ordering.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0c0612",
  "theme_color": "#0c0612",
  "categories": [
    "lifestyle",
    "social",
    "shopping"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.afterdark.social"
    },
    {
      "platform": "amazon",
      "id": "com.afterdark.social"
    },
    {
      "platform": "indus",
      "id": "com.afterdark.social"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
